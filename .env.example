SCHULMANAGER_USERNAME=your-email
SCHULMANAGER_PASSWORD=your-password
# Default first associated student; alternatively specify the stable ID:
# SCHULMANAGER_STUDENT_ID=2407028
# SCHULMANAGER_STUDENT=1
# SCHULMANAGER_INSTITUTION_ID=242
GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/calendar-id%40group.calendar.google.com/private-REPLACE/basic.ics
# Alternatively GOOGLE_CALENDAR_ID=calendar-id@group.calendar.google.com
GOOGLE_CLIENT_ID=your-web-app-client-id
GOOGLE_CLIENT_SECRET=your-web-app-client-secret
# Optional legacy token; without it, OAuth is completed once through the callback.
# GOOGLE_REFRESH_TOKEN=your-refresh-token
# Public DNS name must resolve to this server; Caddy obtains and renews HTTPS.
# GOOGLE_OAUTH_DOMAIN=sync.example.net
# Register this exact full URL in the Google OAuth Web application client.
# GOOGLE_OAUTH_REDIRECT_URI=https://sync.example.net/oauth/google/callback
# The named Docker volume stores the refresh token here automatically.
GOOGLE_TOKEN_PATH=/data/google-refresh-token.json
# Optional: use the published GHCR image instead of the local build.
# SCHULMANAGER_IMAGE=ghcr.io/OWNER/REPOSITORY:latest
SYNC_WEEKS=26
SYNC_HOURS=4
SYNC_TIMEZONE=Europe/Berlin
# Prefix exam titles with the selected student's first name, even for one student.
# Multiple associated students are prefixed automatically.
# SYNC_PREFIX_STUDENT_NAME=true
