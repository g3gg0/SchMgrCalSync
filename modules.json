      "id": "exemptions/poqa:modules/exemptions/exemption-request:findAll",
      "module": "exemptions",
      "request": {
        "moduleName": "exemptions",
        "endpointName": "poqa",
        "parameters": {
          "action": {
            "model": "modules/exemptions/exemption-request",
            "action": "findAll",
            "parameters": [
              {
                "where": {
                  "studentId": "$studentId",
                  "isInternal": {
                    "$not": true
                  }
                },
                "include": [
                  {
                    "association": "student",
                    "required": true
                  }
                ]
              }
            ]
          },
          "uiState": "main.modules.exemptions.request"
