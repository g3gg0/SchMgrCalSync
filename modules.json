    {
      "id": "sick/poqa:main/student:findAll",
      "module": "sick",
      "request": {
        "moduleName": "sick",
        "endpointName": "poqa",
        "parameters": {
          "action": {
            "model": "main/student",
            "action": "findAll",
            "parameters": [
              {
                "attributes": [
                  "id",
                  "firstname",
                  "lastname"
                ],
                "where": {
                  "id": {
                    "$in": [
                      "$studentId"
                    ]
                  }
                },
                "include": [
                  {
                    "association": "certificateObligations",
                    "attributes": [
                      "id",
                      "defaultLevel",
                      "examLevel",
                      "start",
                      "end",
                      "studentId"
                    ],
                    "required": false,
                    "where": {
                      "end": {
                        "$gte": "$start"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "uiState": "main.modules.sick.reports"
        }
      }
    },
    {
      "id": "sick/poqa:modules/exemptions/exemption-request:findOne",
      "module": "sick",
      "request": {
        "moduleName": "sick",
        "endpointName": "poqa",
        "parameters": {
          "action": {
            "model": "modules/exemptions/exemption-request",
            "action": "findOne",
            "parameters": [
              {
                "attributes": [
                  "id",
                  "studentId",
                  "startDate",
                  "endDate",
                  "startTime",
                  "endTime"
                ],
                "where": {
                  "studentId": "$studentId",
                  "endDate": {
                    "$gte": "$start"
                  },
                  "startDate": {
                    "$lte": "$end"
                  },
                  "isInternal": {
                    "$not": true
                  },
                  "startTime": null,
                  "endTime": null,
                  "granted": true
                }
              }
            ]
          },
          "uiState": "main.modules.sick.reports"
        }
      }
    },
